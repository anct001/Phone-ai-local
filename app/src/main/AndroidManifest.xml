<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed only to download models from HuggingFace; inference is fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vulkan requirement — Snapdragon 8s Gen 4 supports this -->
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="false" />

    <application
        android:name=".PhoneAIApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.PhoneAI"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <activity
            android:name=".ui.ChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ModelSelectionActivity"
            android:exported="false"
            android:parentActivityName=".ui.ChatActivity" />

    </application>

</manifest>
