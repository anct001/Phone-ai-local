<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/bg_light">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_form_check"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="帳票を撮影してAIで検証します"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/tv_api_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ APIキーが未設定です。local.propertiesに CLAUDE_API_KEY を設定してください。"
        android:textColor="#C62828"
        android:background="#FFEBEE"
        android:padding="12dp"
        android:textSize="13sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_capture"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="📷  帳票を撮影する"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.Button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_history"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="📋  検証履歴"
        android:textSize="16sp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="対応帳票: 加工指示書・ロット管理票 / ライン作業日報"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="32dp"
        android:gravity="center" />

</LinearLayout>
