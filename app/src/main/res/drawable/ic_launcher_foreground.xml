<?xml version="1.0" encoding="utf-8"?>
<!--
    Simple "phone + AI signal" icon:
    a rounded rectangle (phone body) with three curved arcs on the right
    representing wireless/AI signal waves.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Phone body -->
    <path
        android:fillColor="#3B82F6"
        android:pathData="
          M34,24 L58,24
          Q66,24 66,32
          L66,76
          Q66,84 58,84
          L34,84
          Q26,84 26,76
          L26,32
          Q26,24 34,24 Z" />

    <!-- Screen cutout (white) -->
    <path
        android:fillColor="#1A1D27"
        android:pathData="M30,36 L62,36 L62,72 L30,72 Z" />

    <!-- Home indicator dot -->
    <path
        android:fillColor="#3B82F6"
        android:pathData="M46,77 a2,2 0 1 0 0.01,0 Z" />

    <!-- AI signal wave 1 (small) -->
    <path
        android:strokeColor="#60A5FA"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M72,42 Q78,48 72,54" />

    <!-- AI signal wave 2 (medium) -->
    <path
        android:strokeColor="#60A5FA"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M77,37 Q87,48 77,59" />

    <!-- AI signal wave 3 (large) -->
    <path
        android:strokeColor="#93C5FD"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M82,32 Q96,48 82,64" />

    <!-- Small "AI" dot in screen center -->
    <path
        android:fillColor="#60A5FA"
        android:pathData="M46,54 a4,4 0 1 0 0.01,0 Z" />

</vector>
